# Embedded Postgres (local default)
DATABASE_URL=pglite://./data/facetroop
PORT=3001
ALLOWED_ORIGINS=https://www.facetroop.com,https://facetroop.com,http://localhost:8443,http://127.0.0.1:8443

# Production Postgres example:
# DATABASE_URL=postgres://facetroop:facetroop@localhost:5432/facetroop

# Optional SMTP for login OTP email. Without this, the API logs the code
# and returns it as devOtp for local testing.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=FACETROOP <noreply@facetroop.com>

# Optional SMS for Aadhaar OTP. Sent to the registration phone number.
# Use one provider:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1234567890
# MSG91_AUTH_KEY=
# MSG91_SENDER=FTROOP
# FAST2SMS_API_KEY=
