# Embedded Postgres (local default)
DATABASE_URL=pglite://./data/facerights
PORT=3001
ALLOWED_ORIGINS=https://www.facetroop.com,https://facetroop.com,http://localhost:8443,http://127.0.0.1:8443

# Production Postgres example:
# DATABASE_URL=postgres://facerights:facerights@localhost:5432/facerights

# Optional SMTP for login OTP email. Without this, the API logs the code
# and returns it as devOtp for local testing.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=FACERIGHTS <noreply@facetroop.com>
